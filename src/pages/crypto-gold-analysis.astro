---
import Layout from '../layouts/Layout.astro';
import { getPublishedArticles } from '../lib/notion.js';

const category = 'Phân Tích Crypto và Gold';
const articles = await getPublishedArticles(category);
---

<Layout title="Crypto & Gold SMC Analysis | Smart Trader VIP" activeNav="Crypto & Gold SMC" description="Institutional technical research on Gold (XAUUSD) and Bitcoin applying Smart Money Concepts, Order Blocks, and fair value gaps.">

  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-12">
    <!-- Category Header -->
    <div class="mb-10 text-center max-w-3xl mx-auto">
      <span class="text-xs font-bold uppercase tracking-wider text-amber-400 bg-amber-950/60 border border-amber-800/60 px-3 py-1 rounded-full">Institutional Technicals</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white mt-4 mb-3">Crypto & Gold SMC Analysis</h1>
      <p class="text-sm sm:text-base text-slate-400">
        Decode institutional liquidity footprints: Map crucial Order Blocks, decipher inducement traps, and execute high-probability Risk-to-Reward entries.
      </p>
    </div>

    <!-- FEATURED CONVERSION ADS: DUAL COMBO EA BOT & VIP SIGNALS -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-12">
      <!-- CARD 1: MT5 EA BOT (NO PAIN NO GAIN) -->
      <div class="p-6 sm:p-7 rounded-3xl bg-gradient-to-br from-cyan-950/80 via-slate-900 to-slate-950 border-2 border-cyan-500/40 shadow-2xl relative overflow-hidden group flex flex-col justify-between">
        <div class="absolute -right-10 -bottom-10 w-52 h-52 bg-cyan-500/10 rounded-full blur-3xl group-hover:bg-cyan-500/20 transition-all duration-700 pointer-events-none"></div>

        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 inline-flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
              🤖 AUTOMATED MT5 EA BOT
            </span>
            <span class="text-xs font-bold text-cyan-400">Myfxbook +1,114.7%</span>
          </div>

          <h2 class="text-xl sm:text-2xl font-extrabold text-white mb-2 leading-snug">
            No Pain No Gain EA: 24/5 Automated Gold Execution
          </h2>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-6">
            Institutional liquidity hunting algorithm with strict fund-grade risk parameters and zero floating martingale. Battle-tested live on PU Prime ASIC liquidity feeds.
          </p>

          <div class="grid grid-cols-2 gap-3 mb-6 p-3 rounded-xl bg-slate-950/60 border border-cyan-900/40 text-xs">
            <div>
              <div class="text-slate-400 text-[11px]">Primary Asset</div>
              <div class="font-bold text-white">Gold XAUUSD (M15)</div>
            </div>
            <div>
              <div class="text-slate-400 text-[11px]">Exclusive Access</div>
              <div class="font-bold text-cyan-400">1-Week Free Trial</div>
            </div>
          </div>
        </div>

        <div class="space-y-2.5">
          <a
            href="https://t.me/willrichus"
            target="_blank"
            class="w-full py-3.5 px-4 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-500 hover:from-cyan-400 hover:to-blue-400 text-slate-950 font-extrabold text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-2 shadow-lg shadow-cyan-950/50"
          >
            <i class="fa-solid fa-robot"></i>
            <span>CLAIM 1-WEEK FREE BOT EA TRIAL</span>
          </a>

          <a
            href="/bot-ea-trading"
            class="w-full py-2.5 px-4 rounded-xl bg-slate-800/80 hover:bg-slate-700 text-slate-200 border border-slate-700 font-bold text-xs text-center transition-colors block"
          >
            Review Strategy & Live Myfxbook Track Record →
          </a>
        </div>
      </div>

      <!-- CARD 2: VIP TRADING SIGNALS -->
      <div class="p-6 sm:p-7 rounded-3xl bg-gradient-to-br from-amber-950/80 via-slate-900 to-slate-950 border-2 border-amber-500/40 shadow-2xl relative overflow-hidden group flex flex-col justify-between">
        <div class="absolute -right-10 -bottom-10 w-52 h-52 bg-amber-500/10 rounded-full blur-3xl group-hover:bg-amber-500/20 transition-all duration-700 pointer-events-none"></div>

        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider bg-amber-500/20 text-amber-300 border border-amber-500/40 inline-flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
              👑 VIP SMC SIGNALS
            </span>
            <span class="text-xs font-bold text-amber-400">Winrate 78.5%</span>
          </div>

          <h2 class="text-xl sm:text-2xl font-extrabold text-white mb-2 leading-snug">
            Live Gold & Crypto SMC Signals Desk
          </h2>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-6">
            Capture institutional sweeps and unmitigated order blocks. Average Risk-to-Reward ratio 1:2.8+. Sub-second Telegram alerts with verified entry, TP, and SL.
          </p>

          <div class="grid grid-cols-2 gap-3 mb-6 p-3 rounded-xl bg-slate-950/60 border border-amber-900/40 text-xs">
            <div>
              <div class="text-slate-400 text-[11px]">Signal Frequency</div>
              <div class="font-bold text-white">3-5 High-Grade / Day</div>
            </div>
            <div>
              <div class="text-slate-400 text-[11px]">Membership Fee</div>
              <div class="font-bold text-amber-400">Free via Partner Broker</div>
            </div>
          </div>
        </div>

        <div class="space-y-2.5">
          <a
            href="/vip-trading-signals#vip-flow"
            class="w-full py-3.5 px-4 rounded-xl bg-gradient-to-r from-amber-500 to-yellow-500 hover:from-amber-400 hover:to-yellow-400 text-slate-950 font-extrabold text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-2 shadow-lg shadow-amber-950/50"
          >
            <i class="fa-solid fa-crown"></i>
            <span>ACTIVATE VIP VIA PARTNER BROKER</span>
          </a>

          <a
            href="https://t.me/channelmcg"
            target="_blank"
            class="w-full py-2.5 px-4 rounded-xl bg-slate-800/80 hover:bg-slate-700 text-slate-200 border border-slate-700 font-bold text-xs text-center transition-colors block"
          >
            Join Free Telegram Channel (@channelmcg) →
          </a>
        </div>
      </div>
    </div>

    <!-- ARTICLE CARDS WITH 16:9 FEATURED THUMBNAILS -->
    {articles.length === 0 ? (
      <div class="text-center py-16 bg-slate-900/50 rounded-2xl border border-slate-800">
        <p class="text-slate-400">No articles published yet in this category. Add new posts via your Notion database!</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {articles.map((art) => (
          <article class="bg-slate-900/80 border border-slate-800 rounded-2xl overflow-hidden hover:border-amber-500/50 transition-all flex flex-col justify-between group shadow-xl">
            <div>
              <!-- 16:9 THUMBNAIL -->
              <a href={`/p/${art.slug}`} class="block aspect-video overflow-hidden bg-slate-950 border-b border-slate-800">
                <img
                  src={art.featuredImage}
                  alt={art.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              </a>

              <div class="p-6">
                <div class="flex items-center justify-between text-xs text-slate-400 mb-3">
                  <span class="text-amber-400 font-semibold">Crypto & Gold SMC</span>
                  <span>{art.date}</span>
                </div>
                <h2 class="text-lg font-bold text-white hover:text-amber-300 transition-colors mb-3 leading-snug">
                  <a href={`/p/${art.slug}`}>{art.title}</a>
                </h2>
                <p class="text-xs sm:text-sm text-slate-400 line-clamp-3 mb-4 leading-relaxed">
                  {art.summary}
                </p>
              </div>
            </div>

            <div class="px-6 pb-6 pt-2 border-t border-slate-800/60">
              <a href={`/p/${art.slug}`} class="text-xs font-semibold text-amber-400 hover:text-amber-300 flex items-center gap-1.5">
                Read Full Analysis →
              </a>
            </div>
          </article>
        ))}
      </div>
    )}
  </section>

</Layout>
