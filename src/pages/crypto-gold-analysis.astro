---
import Layout from '../layouts/Layout.astro';
import { getPublishedArticles } from '../lib/notion.js';

const category = 'Phân Tích Crypto và Gold';
const articles = await getPublishedArticles(category);
---

<Layout title="Crypto & Gold SMC Analysis | Smart Trader VIP" activeNav="Crypto & Gold SMC" description="Institutional technical research on Gold (XAUUSD) and Bitcoin applying Smart Money Concepts, Order Blocks, and fair value gaps.">

  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-12">
    <div class="mb-10 text-center max-w-3xl mx-auto">
      <span class="text-xs font-bold uppercase tracking-wider text-amber-400 bg-amber-950/60 border border-amber-800/60 px-3 py-1 rounded-full">Institutional Technicals</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white mt-4 mb-3">Crypto & Gold SMC Analysis</h1>
      <p class="text-sm sm:text-base text-slate-400">
        Map institutional liquidity footprints: Uncover high-probability Order Blocks, detect stop hunt inducements, and target asymmetric R:R entries.
      </p>
    </div>

    <!-- Dual Conversion Box -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
      <div class="p-6 bg-gradient-to-r from-amber-950/50 to-slate-900 border border-amber-800/60 rounded-2xl flex items-center justify-between">
        <div>
          <span class="text-xs font-bold text-amber-400 uppercase">LIVE STREAMING</span>
          <h3 class="text-base font-bold text-white mt-1">VIP Trading Signals</h3>
          <p class="text-xs text-slate-400">Real-time order flow updates via direct MT5 Webhook sync.</p>
        </div>
        <a href="/vip-trading-signals" class="px-4 py-2 bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-bold rounded-lg transition-colors whitespace-nowrap">
          Open Signal Desk →
        </a>
      </div>

      <div class="p-6 bg-gradient-to-r from-cyan-950/50 to-slate-900 border border-cyan-800/60 rounded-2xl flex items-center justify-between">
        <div>
          <span class="text-xs font-bold text-cyan-400 uppercase">ALGORITHMIC DESK</span>
          <h3 class="text-base font-bold text-white mt-1">Automated Bot EA (Myfxbook)</h3>
          <p class="text-xs text-slate-400">Verified live performance of No Pain No Gain 1 & 2. 1-week trial included.</p>
        </div>
        <a href="/automated-bot-trading" class="px-4 py-2 bg-cyan-500 hover:bg-cyan-400 text-slate-950 text-xs font-bold rounded-lg transition-colors whitespace-nowrap">
          View Bot EA →
        </a>
      </div>
    </div>

    {articles.length === 0 ? (
      <div class="text-center py-16 bg-slate-900/50 rounded-2xl border border-slate-800">
        <p class="text-slate-400">No technical breakdowns published yet in this category. Add new posts via your Notion database!</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {articles.map((art) => (
          <article class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 hover:border-amber-500/50 transition-all flex flex-col justify-between hover:shadow-xl">
            <div>
              <div class="flex items-center justify-between text-xs text-slate-400 mb-3">
                <span class="text-amber-400 font-semibold">SMC Analysis</span>
                <span>{art.date}</span>
              </div>
              <h2 class="text-lg font-bold text-white hover:text-amber-300 transition-colors mb-3 leading-snug">
                <a href={`/p/${art.slug}`}>{art.title}</a>
              </h2>
              <p class="text-xs sm:text-sm text-slate-400 line-clamp-3 mb-6 leading-relaxed">
                {art.summary}
              </p>
            </div>
            <a href={`/p/${art.slug}`} class="text-xs font-semibold text-amber-400 hover:text-amber-300 flex items-center gap-1.5">
              Read Technical Playbook →
            </a>
          </article>
        ))}
      </div>
    )}
  </section>

</Layout>
