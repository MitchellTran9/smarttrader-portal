---
import Layout from '../layouts/Layout.astro';
---

<Layout title="VIP Trading Signals - Institutional SMC Order Flow | Smart Trader VIP" activeNav="VIP Trading Signals" description="High-probability Gold (XAUUSD) and Crypto trading signals based on Smart Money Concepts, Order Block mitigation, and direct MT5 Webhook sync.">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

  <div class="trading-signal-wrapper max-w-7xl mx-auto px-4 sm:px-6 py-12">
    <!-- Hero Section -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-950/80 border border-amber-800/80 text-amber-400 text-xs font-semibold uppercase tracking-wider mb-4">
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
        Verified Institutional Winrate
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white leading-tight mb-4">
        VIP Trading Signals: <br/>
        <span class="bg-gradient-to-r from-amber-400 via-orange-300 to-yellow-200 bg-clip-text text-transparent">SMC Order Flow Execution</span>
      </h1>
      <p class="text-slate-400 text-sm sm:text-base leading-relaxed">
        Stop chasing retail indicators. Follow institutional liquidity sweeps with verified 78.5% win rate, disciplined 1:2.8 average Risk/Reward, and real-time MT5 alerts.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="https://t.me/channelmcg" target="_blank" class="px-6 py-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs uppercase tracking-wider transition-colors shadow-lg shadow-amber-950/50 flex items-center gap-2">
          <span>🚀 Join Free Signals Channel</span>
        </a>
        <a href="https://puprime.org/forex-trading-account/?affid=27133479" target="_blank" class="px-6 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs uppercase tracking-wider border border-slate-700 transition-colors flex items-center gap-2">
          <span>🏦 Open PU Prime Partner Account</span>
        </a>
      </div>
    </div>

    <!-- Live Signal Cards / Specs Grid -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-16">
      <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 text-center">
        <div class="text-3xl font-extrabold text-emerald-400 mb-1">78.5%</div>
        <div class="text-xs text-slate-400 uppercase font-semibold">Verified Winrate</div>
      </div>
      <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 text-center">
        <div class="text-3xl font-extrabold text-amber-400 mb-1">1:2.8</div>
        <div class="text-xs text-slate-400 uppercase font-semibold">Average Risk/Reward</div>
      </div>
      <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 text-center">
        <div class="text-3xl font-extrabold text-cyan-400 mb-1">&lt; 1%</div>
        <div class="text-xs text-slate-400 uppercase font-semibold">Max Risk Per Trade</div>
      </div>
      <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 text-center">
        <div class="text-3xl font-extrabold text-purple-400 mb-1">24/5</div>
        <div class="text-xs text-slate-400 uppercase font-semibold">Global Market Coverage</div>
      </div>
    </div>

    <!-- Live Signal Mock Display -->
    <div class="p-8 rounded-3xl bg-slate-900/80 border border-slate-800 mb-16">
      <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-800">
        <div>
          <span class="text-xs text-emerald-400 font-bold uppercase">LIVE TELEMETRY DESK</span>
          <h3 class="text-lg font-bold text-white mt-1">Real-time Institutional Signal Feed</h3>
        </div>
        <span class="px-3 py-1 bg-emerald-950 text-emerald-400 rounded-full text-xs font-semibold animate-pulse">● Live Sync</span>
      </div>

      <div class="space-y-4">
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800/80 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
          <div class="flex items-center gap-4">
            <span class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center font-bold text-sm">XAU</span>
            <div>
              <div class="text-sm font-bold text-white flex items-center gap-2">
                <span>#XAUUSD (Gold)</span>
                <span class="px-2 py-0.5 rounded text-xs bg-emerald-950 text-emerald-400 font-semibold">BUY 🟢</span>
              </div>
              <div class="text-xs text-slate-400 mt-1">Entry: 3854.89 • SL: 3848.00 • TP: 3870.50</div>
            </div>
          </div>
          <div class="text-right">
            <span class="text-xs text-emerald-400 font-bold">+28 pips in profit</span>
            <div class="text-xs text-slate-500">Triggered 12m ago via MT5 EA</div>
          </div>
        </div>

        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800/80 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
          <div class="flex items-center gap-4">
            <span class="w-10 h-10 rounded-xl bg-cyan-500/10 text-cyan-400 flex items-center justify-center font-bold text-sm">BTC</span>
            <div>
              <div class="text-sm font-bold text-white flex items-center gap-2">
                <span>#BTCUSDT (Bitcoin)</span>
                <span class="px-2 py-0.5 rounded text-xs bg-emerald-950 text-emerald-400 font-semibold">BUY 🟢</span>
              </div>
              <div class="text-xs text-slate-400 mt-1">Entry: 91,420 • SL: 89,900 • TP: 94,500</div>
            </div>
          </div>
          <div class="text-right">
            <span class="text-xs text-emerald-400 font-bold">+1.8% gain running</span>
            <div class="text-xs text-slate-500">Triggered 45m ago via MT5 EA</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
