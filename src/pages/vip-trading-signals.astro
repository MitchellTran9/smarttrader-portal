  <!-- Scripts: Capital Simulator & Real-time Live Signal Polling -->
  <script is:inline>
    // 🧮 CAPITAL SIMULATOR SCRIPT
    const slider = document.getElementById('capitalSlider');
    const capitalDisplay = document.getElementById('capitalDisplay');
    const monthlyProfit = document.getElementById('monthlyProfit');
    const recommendedVol = document.getElementById('recommendedVol');
    const compoundProfit = document.getElementById('compoundProfit');

    function formatCurrency(num) {
      return '$' + num.toLocaleString();
    }

    function updateSimulation() {
      if (!slider) return;
      const capital = parseInt(slider.value);
      if (capitalDisplay) capitalDisplay.innerText = formatCurrency(capital);

      // Estimated monthly profit: 18% to 26%
      const minProfit = Math.round(capital * 0.18);
      const maxProfit = Math.round(capital * 0.26);
      if (monthlyProfit) monthlyProfit.innerText = `+${formatCurrency(minProfit)} - ${formatCurrency(maxProfit)}`;

      // Safe lot volume: 0.02 to 0.03 lot per $1000
      const minLot = (capital * 0.00002).toFixed(2);
      const maxLot = (capital * 0.00003).toFixed(2);
      if (recommendedVol) recommendedVol.innerText = `${minLot} - ${maxLot} lot`;

      // Compound 6 months: capital * (1 + 0.18)^6 to capital * (1 + 0.23)^6
      const compoundMin = Math.round(capital * Math.pow(1.18, 6));
      const compoundMax = Math.round(capital * Math.pow(1.23, 6));
      if (compoundProfit) compoundProfit.innerText = `${formatCurrency(compoundMin)} - ${formatCurrency(compoundMax)}`;
    }

    if (slider) {
      slider.addEventListener('input', updateSimulation);
      updateSimulation();
    }

    // 📡 LIVE REALTIME SIGNALS FETCHER (https://signal.smarttrader.vip/api/signals)
    async function fetchLiveSignals() {
      try {
        const res = await fetch('https://signal.smarttrader.vip/api/signals');
        if (!res.ok) return;
        const data = await res.json();

        // 1. Render Gold MT5 (Max 5 items)
        const goldContainer = document.getElementById('mt5GoldContainer');
        if (goldContainer) {
          if (data && data.gold_mt5 && data.gold_mt5.length > 0) {
            goldContainer.innerHTML = data.gold_mt5.slice(0, 5).map(item => {
              const isOpen = item.status === 'OPEN';
              const isBuy = (item.type || '').toUpperCase() === 'BUY';
              const typeClass = isBuy ? 'bg-emerald-500/20 text-emerald-400' : 'bg-rose-500/20 text-rose-400';
              const profitNum = parseFloat(item.profit || 0);
              const profitClass = profitNum >= 0 ? 'text-emerald-400' : 'text-rose-400';
              const profitSign = profitNum >= 0 ? '+' : '';

              if (isOpen) {
                return `
                <div class="p-5 rounded-2xl bg-slate-950/80 border border-amber-500/30 relative">
                  <div class="flex items-center justify-between mb-3">
                    <div class="flex items-center gap-2">
                      <span class="px-2.5 py-1 rounded-lg text-xs font-black ${typeClass}">${item.type} NOW</span>
                      <span class="text-sm font-bold text-white font-mono">${item.symbol}</span>
                      <span class="text-xs text-slate-400 font-mono">Vol: ${item.volume || 0.1} lot</span>
                    </div>
                    <span class="text-xs font-bold text-amber-400 flex items-center gap-1.5">
                      <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span> RUNNING ${item.pips ? `(+${item.pips}p)` : ''}
                    </span>
                  </div>
                  <div class="grid grid-cols-4 gap-2 p-3 rounded-xl bg-white/[0.02] border border-white/5 font-mono text-xs mb-3">
                    <div><span class="text-slate-500 block text-[10px]">ENTRY</span><span class="text-slate-200 font-bold">${item.entry || '---'}</span></div>
                    <div><span class="text-slate-500 block text-[10px]">STOP LOSS</span><span class="text-rose-400 font-bold">${item.sl || '---'}</span></div>
                    <div><span class="text-slate-500 block text-[10px]">TP1</span><span class="text-emerald-400 font-bold">${item.tp1 || '---'}</span></div>
                    <div><span class="text-slate-500 block text-[10px]">TP2</span><span class="text-emerald-400 font-bold">${item.tp2 || 'Open'}</span></div>
                  </div>
                  <div class="flex items-center justify-between text-xs text-slate-400">
                    <span>Time: <strong class="text-slate-300 font-mono">${item.time || 'Just now'}</strong></span>
                    <span>${profitNum !== 0 ? `Unrealized PnL: <strong class="${profitClass} font-bold font-mono">${profitSign}$${Math.abs(profitNum).toFixed(2)}</strong>` : '<span class="text-amber-400 font-medium">Tracking Position</span>'}</span>
                  </div>
                </div>`;
              } else {
                return `
                <div class="p-5 rounded-2xl bg-slate-950/60 border border-slate-800 relative">
                  <div class="flex items-center justify-between mb-3">
                    <div class="flex items-center gap-2">
                      <span class="px-2.5 py-1 rounded-lg text-xs font-black bg-slate-800 text-slate-300">${item.type} (CLOSED)</span>
                      <span class="text-sm font-bold text-white font-mono">${item.symbol}</span>
                      <span class="text-xs text-slate-400 font-mono">Vol: ${item.volume || 0.1} lot</span>
                    </div>
                    <span class="text-xs font-bold ${profitClass} flex items-center gap-1">
                      <i class="fa-solid fa-circle-check"></i> ${profitNum >= 0 ? 'PROFIT' : 'STOPPED'}
                    </span>
                  </div>
                  <div class="grid grid-cols-4 gap-2 p-3 rounded-xl bg-white/[0.02] border border-white/5 font-mono text-xs mb-3">
                    <div><span class="text-slate-500 block text-[10px]">ENTRY</span><span class="text-slate-300 font-bold">${item.entry || '---'}</span></div>
                    <div><span class="text-slate-500 block text-[10px]">STOP LOSS</span><span class="text-slate-400 font-bold">${item.sl || '---'}</span></div>
                    <div><span class="text-slate-500 block text-[10px]">CLOSE PRICE</span><span class="text-slate-200 font-bold">${item.close_price || item.entry || '---'}</span></div>
                    <div><span class="text-slate-500 block text-[10px]">RESULT PNL</span><span class="${profitClass} font-bold font-mono">${profitSign}$${Math.abs(profitNum).toFixed(2)}</span></div>
                  </div>
                  <div class="flex items-center justify-between text-xs text-slate-400">
                    <span>Close Time: ${item.time || 'Today'}</span>
                    <span class="text-amber-400 font-semibold">100% MT5 Transparency</span>
                  </div>
                </div>`;
              }
            }).join('');
          } else {
            goldContainer.innerHTML = `
            <div class="p-8 rounded-2xl bg-slate-950/80 border border-slate-800 text-center">
              <div class="w-12 h-12 rounded-2xl bg-amber-500/10 text-amber-400 flex items-center justify-center mx-auto mb-3 border border-amber-500/20">
                <i class="fa-solid fa-satellite-dish text-xl animate-pulse"></i>
              </div>
              <h4 class="text-base font-bold text-white mb-1">Connecting to MT5 Real Terminal</h4>
              <p class="text-xs text-slate-400">Live Gold (XAUUSD) signals will stream here automatically upon execution on MT5.</p>
            </div>`;
          }
        }

        // 2. Render Telegram Crypto Feed (Max 5 items)
        const cryptoContainer = document.getElementById('telegramCryptoContainer');
        if (cryptoContainer) {
          if (data && data.crypto_telegram && data.crypto_telegram.length > 0) {
            cryptoContainer.innerHTML = data.crypto_telegram.slice(0, 5).map(c => {
              const isLong = (c.action || '').toUpperCase() === 'LONG';
              const actClass = isLong ? 'bg-emerald-500/20 text-emerald-400' : 'bg-rose-500/20 text-rose-400';
              const tpText = Array.isArray(c.tps) ? c.tps.join(' - ') : c.tps;
              return `
              <div class="p-3.5 rounded-2xl bg-slate-950/80 border border-slate-800 hover:border-cyan-500/30 transition-all">
                <div class="flex items-center justify-between mb-2">
                  <div class="flex items-center gap-2">
                    <span class="px-2 py-0.5 rounded text-[10px] font-black ${actClass}">${c.action} ${c.leverage || '20x'}</span>
                    <span class="text-sm font-bold text-white font-mono">#${c.symbol}</span>
                  </div>
                  <span class="text-[11px] font-bold text-emerald-400">${c.status || 'RUNNING'}</span>
                </div>
                <div class="text-xs font-mono text-slate-300 flex justify-between bg-white/[0.02] p-2 rounded-lg">
                  <span>Entry: <strong class="text-white">${c.entry || 'Market'}</strong></span>
                  <span>SL: <strong class="text-rose-400">${c.sl || '---'}</strong></span>
                  <span>TP: <strong class="text-emerald-400">${tpText || '---'}</strong></span>
                </div>
                <div class="flex justify-between items-center text-[10px] text-slate-400 mt-2 px-1">
                  <span>Time: ${c.time || 'Just now'}</span>
                  <span class="text-cyan-400 flex items-center gap-1"><i class="fa-brands fa-telegram text-[11px]"></i> Mitch Capital Global VIP</span>
                </div>
              </div>`;
            }).join('');
          }
        }
      } catch (err) {
        console.log('Signals poll waiting...', err);
      }
    }

    fetchLiveSignals();
    setInterval(fetchLiveSignals, 4000);
  </script>
