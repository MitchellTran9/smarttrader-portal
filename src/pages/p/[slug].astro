            <span>⏱️ Read Time: 5 min</span>
            <span>•</span>
            <span class="text-emerald-400 font-semibold">Author: Smart Trader VIP Quantitative Desk</span>
          </div>

          <!-- Featured Image (16:9) -->
          {article.featuredImage && (
            <div class="mt-6 rounded-2xl overflow-hidden aspect-video bg-slate-950 border border-slate-800 shadow-2xl">
              <img
                src={article.featuredImage}
                alt={article.title}
                class="w-full h-full object-cover"
                loading="eager"
              />
            </div>
          )}

          <!-- Lead Summary -->
