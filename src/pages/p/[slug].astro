  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center space-x-2 text-xs text-slate-400 mb-8">
      <a href="/" class="hover:text-emerald-400 transition-colors">Home</a>
