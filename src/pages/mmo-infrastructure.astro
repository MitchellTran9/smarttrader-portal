---
import Layout from '../layouts/Layout.astro';
import { categories, products } from '../data/mmoProducts.js';

const TELEGRAM_BOT_URL = "https://t.me/chatgpsplusbot";
---

<Layout 
  title="AI Store & Scalable MMO Infrastructure | Smart Trader VIP" 
  activeNav="MMO & Cloud Store" 
  description="Catalog of 84+ licensed AI tools (ChatGPT Plus, Claude 3.5, CapCut Pro, ElevenLabs, Adobe), clean residential proxies, antidetect browser keys and premium digital accounts. Automated 24/7 delivery via Telegram Bot."
>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

  <div class="min-h-screen pb-24 text-slate-100">

    <!-- Hero Section -->
    <section class="relative pt-12 pb-16 px-4 sm:px-6 lg:px-8 border-b border-slate-800/80 bg-gradient-to-b from-[#0f172a]/90 via-[#0b0f17] to-[#0b0f17]">
      <!-- Background Ambient Glow -->
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-emerald-500/10 blur-[120px] pointer-events-none rounded-full"></div>

      <div class="max-w-6xl mx-auto text-center relative z-10">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-950/80 border border-emerald-500/30 text-xs sm:text-sm font-semibold text-emerald-400 mb-6 shadow-lg shadow-emerald-950/40">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          <span>ENTERPRISE DIGITAL VAULT: 84+ LICENSED TOOLS & MMO AUTOMATION KEYS</span>
        </div>

        <!-- Main Title -->
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-tight sm:leading-tight mb-6">
          AI Store & Scalable Growth Cloud: <br class="hidden sm:block" />
          <span class="bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400 bg-clip-text text-transparent">
            Cut 70% Operational Software Costs
          </span>
        </h1>

        <p class="text-slate-300 text-sm sm:text-lg max-w-3xl mx-auto mb-8 leading-relaxed font-normal">
          Instant access to premier genuine licenses <span class="text-emerald-400 font-semibold">(ChatGPT Plus, Claude 3.5, CapCut Pro, ElevenLabs, Adobe Creative Cloud)</span>, high-speed <span class="text-white font-semibold">Clean VPNs & Antidetect Keys</span>. Automated checkout and delivery within 30 seconds via Telegram Bot.
        </p>

        <!-- CTA Action Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12">
          <a 
            href={TELEGRAM_BOT_URL} 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-8 py-4 rounded-xl font-extrabold text-base bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-slate-950 shadow-xl shadow-emerald-500/25 hover:shadow-emerald-500/40 transition-all flex items-center justify-center gap-3 group"
          >
            <i class="fa-brands fa-telegram text-xl group-hover:scale-110 transition-transform"></i>
            <span>ORDER VIA 24/7 TELEGRAM BOT</span>
            <span class="text-xs px-2 py-0.5 rounded bg-slate-950/20 text-slate-950 font-bold ml-1">Instant 30s Delivery</span>
          </a>

          <a 
            href="https://t.me/willrichus" 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-7 py-4 rounded-xl font-bold text-base bg-slate-800/80 hover:bg-slate-700/80 text-slate-200 border border-slate-700 hover:border-emerald-500/50 transition-all flex items-center justify-center gap-2.5"
          >
            <i class="fa-solid fa-gift text-emerald-400"></i>
            <span>Claim Free GPM-Login License Key (@willrichus)</span>
          </a>
        </div>

        <!-- Trust Badges Bar -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 max-w-4xl mx-auto pt-6 border-t border-slate-800/80">
          <div class="p-3.5 rounded-xl bg-slate-900/60 border border-slate-800/80 text-center">
            <div class="text-2xl sm:text-3xl font-extrabold text-emerald-400">100%</div>
            <div class="text-xs text-slate-400 mt-1 font-medium">Genuine Official Licenses</div>
          </div>
          <div class="p-3.5 rounded-xl bg-slate-900/60 border border-slate-800/80 text-center">
            <div class="text-2xl sm:text-3xl font-extrabold text-cyan-400">1:1</div>
            <div class="text-xs text-slate-400 mt-1 font-medium">Full Duration Replacement</div>
          </div>
          <div class="p-3.5 rounded-xl bg-slate-900/60 border border-slate-800/80 text-center">
            <div class="text-2xl sm:text-3xl font-extrabold text-amber-400">30s</div>
            <div class="text-xs text-slate-400 mt-1 font-medium">Automated Bot Delivery</div>
          </div>
          <div class="p-3.5 rounded-xl bg-slate-900/60 border border-slate-800/80 text-center">
            <div class="text-2xl sm:text-3xl font-extrabold text-purple-400">24/7/365</div>
            <div class="text-xs text-slate-400 mt-1 font-medium">Dedicated VIP Tech Support</div>
          </div>
        </div>

      </div>
    </section>

    <!-- 3-Step Buying Guide -->
    <section class="py-10 px-4 sm:px-6 lg:px-8 border-b border-slate-800/60 bg-[#0d131f]/60">
      <div class="max-w-6xl mx-auto">
        <div class="flex flex-col md:flex-row items-center justify-between gap-6 bg-gradient-to-r from-slate-900/90 to-slate-900/40 p-6 sm:p-8 rounded-2xl border border-slate-800">
          <div class="max-w-md">
            <div class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-emerald-400 mb-2">
              <i class="fa-solid fa-bolt"></i> Streamlined 3-Step Purchase
            </div>
            <h3 class="text-xl sm:text-2xl font-bold text-white mb-2">Buy Any Tool Directly via Telegram Bot</h3>
            <p class="text-slate-400 text-xs sm:text-sm">No waiting for agent approvals. Automated payment confirmation and instant key credentials delivery.</p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 w-full md:w-auto flex-1">
            <div class="bg-slate-800/50 border border-slate-700/60 p-4 rounded-xl text-left">
              <div class="w-7 h-7 rounded-full bg-emerald-500/20 text-emerald-400 font-bold text-xs flex items-center justify-center mb-2">1</div>
              <div class="text-xs font-bold text-white mb-1">Pick Your Product</div>
              <div class="text-[11px] text-slate-400">Click any software card below to launch the checkout bot with the item pre-selected.</div>
            </div>

            <div class="bg-slate-800/50 border border-slate-700/60 p-4 rounded-xl text-left">
              <div class="w-7 h-7 rounded-full bg-cyan-500/20 text-cyan-400 font-bold text-xs flex items-center justify-center mb-2">2</div>
              <div class="text-xs font-bold text-white mb-1">Select Duration & Pay</div>
              <div class="text-[11px] text-slate-400">Choose your duration (1mo, 1yr, lifetime) and pay via Crypto (USDT) or QR bank transfer.</div>
            </div>

            <div class="bg-slate-800/50 border border-slate-700/60 p-4 rounded-xl text-left">
              <div class="w-7 h-7 rounded-full bg-purple-500/20 text-purple-400 font-bold text-xs flex items-center justify-center mb-2">3</div>
              <div class="text-xs font-bold text-white mb-1">Instant Credentials</div>
              <div class="text-[11px] text-slate-400">Receive activation keys, account credentials, and setup instructions in under 30 seconds.</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Storefront Catalog Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12" id="catalog">
      
      <!-- Search & Category Filters Bar -->
      <div class="sticky top-[108px] z-40 bg-[#0b0f17]/95 backdrop-blur-md py-4 border-b border-slate-800/80 mb-8">
        <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-4">
          
          <!-- Instant Search Box -->
          <div class="relative flex-1 max-w-lg">
            <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
            <input 
              type="text" 
              id="productSearchInput" 
              placeholder="Search 84+ products (ChatGPT, CapCut, Adobe, VPN, Netflix...)"
              class="w-full bg-slate-900 border border-slate-700/80 rounded-xl pl-10 pr-10 py-2.5 text-sm text-slate-200 placeholder-slate-500 focus:outline-none focus:border-emerald-500 transition-colors shadow-inner"
            />
            <button 
              id="clearSearchBtn" 
              class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-white text-xs p-1"
              title="Clear search"
            >
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>

          <!-- Product Count Status -->
          <div class="text-xs text-slate-400 font-medium flex items-center gap-2">
            <span>Showing:</span>
            <span id="productCounter" class="px-2 py-0.5 rounded-full bg-emerald-950/80 border border-emerald-800/60 text-emerald-400 font-bold">
              {products.length} products
            </span>
          </div>

        </div>

        <!-- Horizontal Category Pills -->
        <div class="flex items-center gap-2 overflow-x-auto scrollbar-none pt-4 pb-1">
          {categories.map((cat, idx) => (
            <button 
              data-cat-btn={cat.id}
              class={`filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all whitespace-nowrap flex items-center gap-2 ${
                idx === 0 
                  ? "bg-emerald-500 text-slate-950 shadow-md shadow-emerald-500/20 active" 
                  : "bg-slate-800/80 hover:bg-slate-700/80 text-slate-300 border border-slate-700/80"
              }`}
            >
              {cat.icon && <i class={`fa-solid ${cat.icon} text-xs`}></i>}
              <span>{cat.name}</span>
              <span class="text-[11px] opacity-75">({cat.count})</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Products Grid -->
      <div id="productGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
        {products.map((p) => {
          const directBuyLink = `${TELEGRAM_BOT_URL}?start=buy_${p.botCmd}`;
          return (
            <div 
              class="product-card group relative bg-slate-900/70 hover:bg-slate-900 border border-slate-800 hover:border-emerald-500/50 rounded-2xl p-5 flex flex-col justify-between transition-all duration-300 hover:shadow-xl hover:shadow-emerald-950/20 hover:-translate-y-1"
              data-category={p.category}
              data-name={p.name.toLowerCase()}
              data-desc={p.desc.toLowerCase()}
              data-tag={p.tag.toLowerCase()}
            >
              <!-- Card Top -->
              <div>
                <!-- Header with Icon & Tag -->
                <div class="flex items-start justify-between gap-3 mb-3.5">
                  <div 
                    class="w-12 h-12 rounded-xl flex items-center justify-center text-xl shadow-md border border-white/10 group-hover:scale-105 transition-transform"
                    style={`background: ${p.color}15; color: ${p.color}; border-color: ${p.color}30;`}
                  >
                    <i class={`fa-solid ${p.icon}`}></i>
                  </div>
                  <span class={`px-2.5 py-1 rounded-full text-[11px] font-bold border ${p.tagColor}`}>
                    {p.tag}
                  </span>
                </div>

                <!-- Product Name -->
                <h3 class="text-base font-bold text-white group-hover:text-emerald-400 transition-colors mb-2 line-clamp-1">
                  {p.name}
                </h3>

                <!-- Product Description -->
                <p class="text-xs text-slate-400 leading-relaxed mb-4 line-clamp-3">
                  {p.desc}
                </p>
              </div>

              <!-- Card Bottom / Action -->
              <div class="pt-3 border-t border-slate-800/80">
                <div class="flex items-center justify-between text-[11px] text-slate-400 mb-3">
                  <span class="flex items-center gap-1.5 text-emerald-400">
                    <i class="fa-solid fa-circle-check text-[10px]"></i> Instant Activation
                  </span>
                  <span class="flex items-center gap-1 text-slate-400">
                    <i class="fa-solid fa-shield text-[10px]"></i> 1:1 Warranty
                  </span>
                </div>

                <a 
                  href={directBuyLink} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="w-full py-2.5 px-3 rounded-xl text-xs font-bold bg-slate-800 hover:bg-emerald-500 hover:text-slate-950 text-slate-200 border border-slate-700 hover:border-emerald-400 transition-all flex items-center justify-center gap-2 group-hover:bg-emerald-500 group-hover:text-slate-950 group-hover:border-emerald-400"
                >
                  <i class="fa-brands fa-telegram text-sm"></i>
                  <span>Order via Bot 24/7</span>
                  <i class="fa-solid fa-arrow-right text-[10px] ml-0.5"></i>
                </a>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Empty State -->
      <div id="noResultsState" class="hidden text-center py-16 px-4">
        <div class="w-16 h-16 rounded-full bg-slate-800 flex items-center justify-center mx-auto text-2xl text-slate-500 mb-4">
          <i class="fa-solid fa-face-frown"></i>
        </div>
        <h4 class="text-lg font-bold text-white mb-1">No matching tools found</h4>
        <p class="text-xs text-slate-400 max-w-md mx-auto mb-6">
          Looking for a custom license or specialized MMO tool? Contact our Telegram bot directly for custom procurement.
        </p>
        <a 
          href={TELEGRAM_BOT_URL} 
          target="_blank"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-emerald-500 text-slate-950 font-bold text-xs hover:bg-emerald-400 transition-all"
        >
          <i class="fa-brands fa-telegram"></i> Request Custom Tool via Bot
        </a>
      </div>

    </section>

    <!-- Bottom Bot CTA Banner -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-20">
      <div class="banner-card-emerald relative overflow-hidden rounded-3xl p-8 sm:p-12 text-center sm:text-left flex flex-col lg:flex-row items-center justify-between gap-8 transition-all duration-300">
        <!-- Background decorative blur -->
        <div class="absolute -right-10 -bottom-10 w-72 h-72 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="max-w-2xl relative z-10">
          <span class="banner-badge-emerald inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold mb-3">
            <i class="fa-solid fa-robot"></i> 24/7 AUTOMATED TELEGRAM BOT
          </span>
          <h2 class="banner-title text-2xl sm:text-3xl font-extrabold mb-3">
            Wholesale Procurement & Team Volume Discounts
          </h2>
          <p class="banner-desc text-xs sm:text-sm leading-relaxed mb-4">
            Bot accepts automated crypto payments (USDT BEP20/TRC20) and international transfers with instant invoice generation. Custom agency pricing available for teams of 5+ members.
          </p>
          <div class="flex flex-wrap items-center gap-4 text-xs banner-bullet">
            <span class="flex items-center gap-1.5"><i class="fa-solid fa-bolt text-emerald-500 dark:text-emerald-400"></i> Instant 30s Delivery</span>
            <span class="flex items-center gap-1.5"><i class="fa-solid fa-lock text-cyan-600 dark:text-cyan-400"></i> 100% Guaranteed Private</span>
            <span class="flex items-center gap-1.5"><i class="fa-solid fa-rotate-left text-amber-600 dark:text-amber-400"></i> Replacement Warranty</span>
          </div>
        </div>

        <div class="relative z-10 flex flex-col sm:flex-row lg:flex-col gap-3 w-full sm:w-auto">
          <a 
            href={TELEGRAM_BOT_URL} 
            target="_blank" 
            rel="noopener noreferrer"
            class="banner-cta-primary-emerald px-8 py-4 rounded-xl font-extrabold text-sm transition-all text-center flex items-center justify-center gap-2 whitespace-nowrap transform hover:scale-[1.02]"
          >
            <i class="fa-brands fa-telegram text-lg"></i>
            <span>OPEN BOT: @chatgpsplusbot</span>
          </a>
          <a 
            href="https://t.me/willrichus" 
            target="_blank" 
            rel="noopener noreferrer"
            class="banner-cta-secondary px-8 py-3.5 rounded-xl font-bold text-xs transition-all text-center flex items-center justify-center gap-2"
          >
            <i class="fa-solid fa-headset text-emerald-600 dark:text-emerald-400"></i>
            <span>1-on-1 VIP Desk (@willrichus)</span>
          </a>
        </div>
      </div>
    </section>

  </div>

  <!-- Client-side Interactive Filter & Search Script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('productSearchInput');
      const clearBtn = document.getElementById('clearSearchBtn');
      const counter = document.getElementById('productCounter');
      const cards = document.querySelectorAll('.product-card');
      const filterBtns = document.querySelectorAll('.filter-btn');
      const noResults = document.getElementById('noResultsState');

      let currentCategory = 'all';
      let currentQuery = '';

      function filterProducts() {
        let visibleCount = 0;

        cards.forEach(card => {
          const category = card.getAttribute('data-category');
          const name = card.getAttribute('data-name') || '';
          const desc = card.getAttribute('data-desc') || '';
          const tag = card.getAttribute('data-tag') || '';

          const matchCat = (currentCategory === 'all' || category === currentCategory);
          const matchQuery = !currentQuery || 
                             name.includes(currentQuery) || 
                             desc.includes(currentQuery) || 
                             tag.includes(currentQuery);

          if (matchCat && matchQuery) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        // Update counter
        if (counter) {
          counter.textContent = `${visibleCount} products`;
        }

        // Toggle empty state
        if (noResults) {
          if (visibleCount === 0) {
            noResults.classList.remove('hidden');
          } else {
            noResults.classList.add('hidden');
          }
        }
      }

      // Category buttons click
      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const catId = btn.getAttribute('data-cat-btn');
          currentCategory = catId;

          // Update active button styles
          filterBtns.forEach(b => {
            b.classList.remove('bg-emerald-500', 'text-slate-950', 'shadow-md', 'shadow-emerald-500/20', 'active');
            b.classList.add('bg-slate-800/80', 'text-slate-300', 'border', 'border-slate-700/80');
          });

          btn.classList.remove('bg-slate-800/80', 'text-slate-300', 'border', 'border-slate-700/80');
          btn.classList.add('bg-emerald-500', 'text-slate-950', 'shadow-md', 'shadow-emerald-500/20', 'active');

          filterProducts();
        });
      });

      // Search input live filtering
      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          currentQuery = e.target.value.trim().toLowerCase();
          
          if (clearBtn) {
            if (currentQuery) {
              clearBtn.classList.remove('hidden');
            } else {
              clearBtn.classList.add('hidden');
            }
          }

          filterProducts();
        });
      }

      // Clear search button
      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          if (searchInput) {
            searchInput.value = '';
            currentQuery = '';
            clearBtn.classList.add('hidden');
            filterProducts();
            searchInput.focus();
          }
        });
      }
    });
  </script>
</Layout>
