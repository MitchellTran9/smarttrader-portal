---
import Layout from '../layouts/Layout.astro';
---

<Layout title="AI Store & Scalable MMO Infrastructure | Smart Trader VIP" activeNav="MMO & Cloud Store" description="Enterprise digital growth infrastructure: Dedicated clean residential IPv4 proxies, high-concurrency cloud VPS, GPM-Login antidetect profiles, and custom AI skills.">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

  <div class="mmo-store-wrapper max-w-7xl mx-auto px-4 sm:px-6 py-12">
    <!-- Hero Banner -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-950/80 border border-emerald-800/80 text-emerald-400 text-xs font-semibold uppercase tracking-wider mb-4">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Zero Checkpoint Isolation
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white leading-tight mb-4">
        AI Store & Scalable MMO Infrastructure: <br/>
        <span class="bg-gradient-to-r from-emerald-400 via-teal-300 to-amber-400 bg-clip-text text-transparent">Cut 70% Operational Costs</span>
      </h1>
      <p class="text-slate-400 text-sm sm:text-base leading-relaxed">
        High-performance private infrastructure engineered for automated growth: Clean static IPv4 proxies, dedicated Windows/Linux VPS, hardware fingerprint spoofing, and licensed creative suites.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="https://t.me/khaydanglaitau" target="_blank" class="px-6 py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs uppercase tracking-wider transition-colors shadow-lg shadow-emerald-950/50 flex items-center gap-2">
          <span>🎁 Claim Free GPM-Login Key</span>
        </a>
        <a href="https://t.me/bannhanhbot" target="_blank" class="px-6 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs uppercase tracking-wider border border-slate-700 transition-colors flex items-center gap-2">
          <span>⚡ Automated 24/7 Order Bot</span>
        </a>
      </div>
    </div>

    <!-- Product Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
      <!-- Item 1 -->
      <div class="p-8 rounded-2xl bg-slate-900/80 border border-slate-800 hover:border-emerald-500/50 transition-all flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center text-2xl mb-4">🌐</div>
          <h3 class="text-lg font-bold text-white mb-2">Static Residential IPv4 Proxies</h3>
          <p class="text-xs text-slate-400 leading-relaxed mb-6">
            100% clean IP subnets with zero abuse history. High-speed SOCKS5/HTTP protocols ideal for X (Twitter), TikTok, Facebook, and Instagram multi-threaded management.
          </p>
          <ul class="text-xs text-slate-300 space-y-2 mb-6">
            <li class="flex items-center gap-2">✓ 99.9% Uptime SLA guaranteed</li>
            <li class="flex items-center gap-2">✓ Unlimited bandwidth & static retention</li>
            <li class="flex items-center gap-2">✓ Multi-geo selection (US, UK, VN, SG)</li>
          </ul>
        </div>
        <a href="https://t.me/bannhanhbot" target="_blank" class="w-full py-2.5 rounded-lg bg-slate-800 hover:bg-emerald-500 hover:text-slate-950 text-white text-xs font-bold text-center transition-colors">
          Order Proxies Now →
        </a>
      </div>

      <!-- Item 2 -->
      <div class="p-8 rounded-2xl bg-slate-900/80 border border-slate-800 hover:border-emerald-500/50 transition-all flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-cyan-500/10 text-cyan-400 flex items-center justify-center text-2xl mb-4">🖥️</div>
          <h3 class="text-lg font-bold text-white mb-2">Cloud High-Performance VPS</h3>
          <p class="text-xs text-slate-400 leading-relaxed mb-6">
            Dedicated NVMe SSD cloud instances optimized for continuous bot execution, MT5 terminal hosting, and 24/7 background web crawlers.
          </p>
          <ul class="text-xs text-slate-300 space-y-2 mb-6">
            <li class="flex items-center gap-2">✓ 1Gbps unmetered network port</li>
            <li class="flex items-center gap-2">✓ Windows Server & Ubuntu pre-installed</li>
            <li class="flex items-center gap-2">✓ Instant automated 60s provisioning</li>
          </ul>
        </div>
        <a href="https://t.me/bannhanhbot" target="_blank" class="w-full py-2.5 rounded-lg bg-slate-800 hover:bg-cyan-500 hover:text-slate-950 text-white text-xs font-bold text-center transition-colors">
          Configure VPS Server →
        </a>
      </div>

      <!-- Item 3 -->
      <div class="p-8 rounded-2xl bg-slate-900/80 border border-slate-800 hover:border-emerald-500/50 transition-all flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center text-2xl mb-4">🛡️</div>
          <h3 class="text-lg font-bold text-white mb-2">GPM-Login Antidetect Suite</h3>
          <p class="text-xs text-slate-400 leading-relaxed mb-6">
            Industry-standard hardware fingerprint masking (Canvas, WebGL, AudioContext, Font List) allowing hundreds of distinct digital personas on one machine.
          </p>
          <ul class="text-xs text-slate-300 space-y-2 mb-6">
            <li class="flex items-center gap-2">✓ Free lifetime tier with community license</li>
            <li class="flex items-center gap-2">✓ Multi-account bulk profile importer</li>
            <li class="flex items-center gap-2">✓ Full Puppeteer & Playwright API sync</li>
          </ul>
        </div>
        <a href="https://t.me/khaydanglaitau" target="_blank" class="w-full py-2.5 rounded-lg bg-slate-800 hover:bg-amber-500 hover:text-slate-950 text-white text-xs font-bold text-center transition-colors">
          Claim Free License →
        </a>
      </div>
    </div>
  </div>
</Layout>
