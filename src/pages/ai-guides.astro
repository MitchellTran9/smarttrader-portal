---
import Layout from '../layouts/Layout.astro';
import { getPublishedArticles } from '../lib/notion.js';

const category = 'Hướng Dẫn Về AI';
const articles = await getPublishedArticles(category);
---

<Layout title="AI & Growth Automation Guides | Smart Trader VIP" activeNav="AI & Growth Guides" description="Actionable playbooks for scaling multi-account operations, anti-detect browser setup, clean proxy infrastructure, and generative AI automations.">

  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-12">
    <div class="mb-10 text-center max-w-3xl mx-auto">
      <span class="text-xs font-bold uppercase tracking-wider text-green-400 bg-green-950/60 border border-green-800/60 px-3 py-1 rounded-full">Tactical Engineering</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white mt-4 mb-3">AI & Growth Automation Guides</h1>
      <p class="text-sm sm:text-base text-slate-400">
        Empowering digital builders: Automate repetitive workflows, isolate hardware footprints, and manage multi-account fleets with zero ban risk.
      </p>
    </div>

    <!-- Lead Magnet Sticky Box -->
    <div class="mb-12 p-6 bg-gradient-to-r from-emerald-950/60 to-slate-900 border border-emerald-800/80 rounded-2xl flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-1">
        <div class="text-xs font-bold uppercase text-emerald-400 tracking-wider">EXCLUSIVE COMMUNITY PERK</div>
        <h3 class="text-lg font-bold text-white">🎁 Free GPM-Login Key & Enterprise AI Automation Pack</h3>
        <p class="text-xs sm:text-sm text-slate-400">Get hardware-spoofed browser profiles and 100+ proven prompts to scale multi-threaded workflows.</p>
      </div>
      <a href="/mmo-infrastructure" class="px-6 py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs uppercase tracking-wider transition-colors whitespace-nowrap shadow-lg shadow-emerald-950/50">
        Claim at MMO Store →
      </a>
    </div>

    {articles.length === 0 ? (
      <div class="text-center py-16 bg-slate-900/50 rounded-2xl border border-slate-800">
        <p class="text-slate-400">No guides published yet in this category. Add new posts via your Notion database!</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {articles.map((art) => (
          <article class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 hover:border-emerald-500/50 transition-all flex flex-col justify-between hover:shadow-xl">
            <div>
              <div class="flex items-center justify-between text-xs text-slate-400 mb-3">
                <span class="text-emerald-400 font-semibold">AI Guides</span>
                <span>{art.date}</span>
              </div>
              <h2 class="text-lg font-bold text-white hover:text-emerald-300 transition-colors mb-3 leading-snug">
                <a href={`/p/${art.slug}`}>{art.title}</a>
              </h2>
              <p class="text-xs sm:text-sm text-slate-400 line-clamp-3 mb-6 leading-relaxed">
                {art.summary}
              </p>
            </div>
            <a href={`/p/${art.slug}`} class="text-xs font-semibold text-emerald-400 hover:text-emerald-300 flex items-center gap-1.5">
              Read Complete Guide →
            </a>
          </article>
        ))}
      </div>
    )}
  </section>

</Layout>
