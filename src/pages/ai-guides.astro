---
import Layout from '../layouts/Layout.astro';
import { getPublishedArticles } from '../lib/notion.js';

const category = 'Hướng Dẫn Về AI';
const articles = await getPublishedArticles(category);
---

<Layout title="AI & Growth Automation Guides | Smart Trader VIP" activeNav="AI & Growth Guides" description="Actionable playbooks for scaling multi-account operations, anti-detect browser setup, clean proxy infrastructure, and generative AI automations.">

  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-12">
    <!-- Category Header -->
    <div class="mb-10 text-center max-w-3xl mx-auto">
      <span class="text-xs font-bold uppercase tracking-wider text-emerald-400 bg-emerald-950/60 border border-emerald-800/60 px-3 py-1 rounded-full">Tactical Engineering</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white mt-4 mb-3">AI & Growth Automation Guides</h1>
      <p class="text-sm sm:text-base text-slate-400">
        Actionable battle-tested playbooks: Automate repetitive workflows with generative AI, configure clean proxy and VPS farms, and safely run multi-threaded automation without checkpoints.
      </p>
    </div>

    <!-- FEATURED CONVERSION AD: 84+ AI TOOLS & TELEGRAM BOT -->
    <div class="banner-card-emerald mb-12 p-6 sm:p-8 rounded-3xl relative overflow-hidden group transition-all duration-300">
      <div class="absolute -right-10 -bottom-10 w-72 h-72 bg-emerald-500/10 rounded-full blur-3xl group-hover:bg-emerald-500/25 transition-all duration-700 pointer-events-none"></div>

      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
        <!-- Banner Info -->
        <div class="lg:col-span-8 space-y-4">
          <div class="flex flex-wrap items-center gap-2.5">
            <span class="banner-badge-emerald px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider inline-flex items-center gap-1.5 shadow-sm">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
              ⚡ 84+ AI TOOLS & MMO INFRASTRUCTURE
            </span>
            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-100 dark:bg-slate-800 text-amber-800 dark:text-yellow-300 border border-amber-300 dark:border-yellow-500/30">
              Save Up to 80% Cost
            </span>
            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-sky-100 dark:bg-slate-800 text-sky-800 dark:text-sky-400 border border-sky-300 dark:border-sky-500/30">
              Instant 3s Bot Delivery
            </span>
          </div>

          <h2 class="banner-title text-xl sm:text-2xl lg:text-3xl font-extrabold leading-snug">
            Automated 24/7 AI Tool Accounts & Dedicated MMO Infrastructure
          </h2>

          <p class="banner-desc text-xs sm:text-sm leading-relaxed max-w-2xl">
            Get instant access to genuine premium tools: ChatGPT Plus, Claude Pro, Midjourney, Runway Gen-3, Cursor Pro, GPM-Login anti-detect, and clean static IPv4 proxies. Purchased automatically via Telegram bot with instant provisioning.
          </p>

          <div class="flex flex-wrap items-center gap-4 text-xs banner-bullet pt-1">
            <span class="flex items-center gap-1.5"><i class="fa-solid fa-bolt text-emerald-500 dark:text-emerald-400"></i> Fully automated 24/7 bot checkout</span>
            <span class="flex items-center gap-1.5"><i class="fa-solid fa-shield text-emerald-500 dark:text-emerald-400"></i> Full-term replacement warranty</span>
            <span class="flex items-center gap-1.5"><i class="fa-solid fa-key text-emerald-500 dark:text-emerald-400"></i> Bundled prompt kits & automation scripts</span>
          </div>
        </div>

        <!-- Conversion CTAs -->
        <div class="lg:col-span-4 flex flex-col gap-3">
          <a
            href="https://t.me/chatgpsplusbot"
            target="_blank"
            class="banner-cta-primary-emerald w-full py-4 px-6 rounded-2xl font-extrabold text-xs sm:text-sm uppercase tracking-wider transition-all transform hover:scale-[1.02] active:scale-[0.98] flex items-center justify-center gap-2"
          >
            <i class="fa-brands fa-telegram text-base"></i>
            <span>BUY INSTANT VIA BOT (@chatgpsplusbot)</span>
          </a>

          <a
            href="/mmo-infrastructure"
            class="banner-cta-secondary w-full py-3 px-5 rounded-xl font-bold text-xs text-center transition-all flex items-center justify-center gap-2"
          >
            <span>Explore All 84+ MMO Tools →</span>
          </a>

          <p class="text-[11px] text-center banner-micro">
            Enterprise / Bulk Inquiries: <a href="https://t.me/willrichus" target="_blank" class="text-emerald-600 dark:text-emerald-400 font-bold hover:underline">@willrichus</a>
          </p>
        </div>
      </div>
    </div>

    <!-- ARTICLE CARDS WITH 16:9 FEATURED THUMBNAILS -->
    {articles.length === 0 ? (
      <div class="text-center py-16 bg-slate-900/50 rounded-2xl border border-slate-800">
        <p class="text-slate-400">No articles published yet in this category. Add new posts via your Notion database!</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {articles.map((art) => (
          <article class="bg-slate-900/80 border border-slate-800 rounded-2xl overflow-hidden hover:border-emerald-500/50 transition-all flex flex-col justify-between group shadow-xl">
            <div>
              <!-- 16:9 THUMBNAIL -->
              <a href={`/p/${art.slug}`} class="block aspect-video overflow-hidden bg-slate-950 border-b border-slate-800">
                <img
                  src={art.featuredImage}
                  alt={art.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              </a>

              <div class="p-6">
                <div class="flex items-center justify-between text-xs text-slate-400 mb-3">
                  <span class="text-emerald-400 font-semibold">AI Guides</span>
                  <span>{art.date}</span>
                </div>
                <h2 class="text-lg font-bold text-white hover:text-emerald-300 transition-colors mb-3 leading-snug">
                  <a href={`/p/${art.slug}`}>{art.title}</a>
                </h2>
                <p class="text-xs sm:text-sm text-slate-400 line-clamp-3 mb-4 leading-relaxed">
                  {art.summary}
                </p>
              </div>
            </div>

            <div class="px-6 pb-6 pt-2 border-t border-slate-800/60">
              <a href={`/p/${art.slug}`} class="text-xs font-semibold text-emerald-400 hover:text-emerald-300 flex items-center gap-1.5">
                Read Full Guide →
              </a>
            </div>
          </article>
        ))}
      </div>
    )}
  </section>

</Layout>
