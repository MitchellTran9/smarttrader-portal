---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Automated Bot EA (MT5) - No Pain No Gain 1 & 2 | Smart Trader VIP" activeNav="Automated Bot EA" description="Institutional algorithmic Expert Advisors for MT5 Gold trading. Verified Myfxbook real track records, strict Max Drawdown control under 10%, and 1-week free trial.">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

  <div class="bot-trading-wrapper max-w-7xl mx-auto px-4 sm:px-6 py-12">
    <!-- Hero Banner -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-950/80 border border-cyan-800/80 text-cyan-400 text-xs font-semibold uppercase tracking-wider mb-4">
        <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
        Zero Martingale Risk
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white leading-tight mb-4">
        Automated Bot Trading: <br/>
        <span class="bg-gradient-to-r from-cyan-400 via-teal-300 to-emerald-400 bg-clip-text text-transparent">No Pain No Gain 1 & 2 (MT5)</span>
      </h1>
      <p class="text-slate-400 text-sm sm:text-base leading-relaxed">
        100% transparent algorithmic execution. Engineered for institutional capital growth on Gold (XAUUSD) with strict stop loss protection and verified Myfxbook auditing.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="https://puprime.onelink.me/O5Jx?af_xp=referral&pid=SHARE&deep_link_value=code-LPDT7V%7Cplatform-copytrading&deep_link_sub1=spid-1519221&af_dp=com.pubusiness.pu%3A%2F%2F&af_force_deeplink=true&campaignCode=liyldrYgYaRUO788T100Vw==" target="_blank" class="px-6 py-3 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold text-xs uppercase tracking-wider transition-colors shadow-lg shadow-cyan-950/50 flex items-center gap-2">
          <span>🤖 1-Week Free Trial on PU Prime</span>
        </a>
        <a href="https://t.me/willrichus" target="_blank" class="px-6 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs uppercase tracking-wider border border-slate-700 transition-colors flex items-center gap-2">
          <span>💬 Direct Developer Desk (@willrichus)</span>
        </a>
      </div>
    </div>

    <!-- 2 Bot Showcase Cards with Myfxbook links -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
      <!-- Bot 1 -->
      <div class="p-8 rounded-3xl bg-slate-900/80 border border-slate-800 hover:border-cyan-500/50 transition-all flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="px-3 py-1 rounded-full bg-cyan-950 text-cyan-400 text-xs font-semibold">Flagship System</span>
            <span class="text-xs text-slate-400">Pair: XAUUSD.sc</span>
          </div>
          <h2 class="text-2xl font-extrabold text-white mb-2">No Pain No Gain 1</h2>
          <p class="text-xs text-slate-400 leading-relaxed mb-6">
            Optimized for steady multi-month compounding with micro-lot sizing, rapid scalp exits, and zero weekend holding risk.
          </p>

          <div class="grid grid-cols-2 gap-4 mb-6">
            <div class="p-4 rounded-xl bg-slate-950 border border-slate-800/80">
              <div class="text-xs text-slate-400">Max Drawdown</div>
              <div class="text-lg font-bold text-emerald-400">&lt; 8.5%</div>
            </div>
            <div class="p-4 rounded-xl bg-slate-950 border border-slate-800/80">
              <div class="text-xs text-slate-400">Auditing</div>
              <div class="text-lg font-bold text-cyan-400">Myfxbook Live</div>
            </div>
          </div>
        </div>

        <a href="https://www.myfxbook.com/portfolio/no-pain-no-gain-1/12317041" target="_blank" class="w-full py-3 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold text-xs text-center uppercase tracking-wider transition-colors">
          View Myfxbook Track Record 1 →
        </a>
      </div>

      <!-- Bot 2 -->
      <div class="p-8 rounded-3xl bg-slate-900/80 border border-slate-800 hover:border-amber-500/50 transition-all flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="px-3 py-1 rounded-full bg-amber-950 text-amber-400 text-xs font-semibold">High Alpha System</span>
            <span class="text-xs text-slate-400">Pair: XAUUSD.sc</span>
          </div>
          <h2 class="text-2xl font-extrabold text-white mb-2">No Pain No Gain 2</h2>
          <p class="text-xs text-slate-400 leading-relaxed mb-6">
            Dynamic trailing stop algorithms capturing multi-pip breakout expansions while maintaining strict risk caps per cycle.
          </p>

          <div class="grid grid-cols-2 gap-4 mb-6">
            <div class="p-4 rounded-xl bg-slate-950 border border-slate-800/80">
              <div class="text-xs text-slate-400">Max Drawdown</div>
              <div class="text-lg font-bold text-emerald-400">&lt; 9.2%</div>
            </div>
            <div class="p-4 rounded-xl bg-slate-950 border border-slate-800/80">
              <div class="text-xs text-slate-400">Auditing</div>
              <div class="text-lg font-bold text-amber-400">Myfxbook Live</div>
            </div>
          </div>
        </div>

        <a href="https://www.myfxbook.com/portfolio/no-pain-no-gain-2/12317050" target="_blank" class="w-full py-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs text-center uppercase tracking-wider transition-colors">
          View Myfxbook Track Record 2 →
        </a>
      </div>
    </div>
  </div>
</Layout>
