---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  activeNav?: string;
}

const {
  title = "Smart Trader VIP - AI Resources, Automation & Institutional Bot Trading Solutions",
  description = "Premier financial intelligence portal: Institutional SMC signals for Gold & Crypto, scalable multi-account MMO infrastructure, and battle-tested MT5 automated Expert Advisors.",
  image = "/banner.jpg",
  activeNav = "Home"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://smarttrader.vip");

const navItems = [
  { name: "Home", href: "/" },
  { name: "Markets & AI 24/7", href: "/markets-ai-247" },
  { name: "AI & Growth Guides", href: "/ai-guides" },
  { name: "MMO & Cloud Store", href: "/mmo-infrastructure", isProduct: true },
  { name: "Crypto & Gold SMC", href: "/crypto-gold-analysis" },
  { name: "VIP Trading Signals", href: "/vip-trading-signals", isProduct: true },
  { name: "Automated Bot EA", href: "/automated-bot-trading", isProduct: true },
  { name: "About Us", href: "/about" }
];
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />

    <style is:global>
      body {
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
        background-color: #0b0f17;
        color: #e2e8f0;
      }
      .font-mono {
        font-family: 'JetBrains Mono', monospace;
      }
      ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
      }
      ::-webkit-scrollbar-track {
        background: #0b0f17;
      }
      ::-webkit-scrollbar-thumb {
        background: #1e293b;
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #334155;
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col bg-[#0b0f17] text-slate-200 antialiased selection:bg-emerald-500 selection:text-white">

    <!-- Substack-Style Header -->
    <header class="border-b border-slate-800/80 bg-[#0b0f17]/95 backdrop-blur-md sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <!-- Top bar: Centered Publication Title & Right Substack Action Icons -->
        <div class="relative flex items-center justify-between py-3 border-b border-slate-800/60 min-h-[52px]">
          <!-- Left: Brand Tag -->
          <div class="flex items-center space-x-2">
            <a href="/" class="flex items-center space-x-2 group">
              <span class="text-[11px] font-bold tracking-wider text-emerald-400 bg-emerald-950/60 border border-emerald-800/60 px-2.5 py-0.5 rounded uppercase">
                SMARTTRADER.VIP
              </span>
            </a>
          </div>

          <!-- Center: Main Title (Exact Substack Header Style) -->
          <div class="hidden md:block absolute left-1/2 -translate-x-1/2 text-center pointer-events-auto">
            <a href="/" class="text-base lg:text-lg font-bold text-white hover:text-emerald-400 transition-colors whitespace-nowrap tracking-tight">
              AI Resources - MMO & Institutional Bot Trading
            </a>
          </div>

          <!-- Mobile Center (if screen small) -->
          <div class="md:hidden flex-1 px-2 text-center">
            <a href="/" class="text-xs sm:text-sm font-bold text-white truncate block">
              AI Resources & Bot Trading
            </a>
          </div>

          <!-- Right: Substack-style Action Icons & Dashboard Button -->
          <div class="flex items-center space-x-2.5 sm:space-x-3.5">
            <!-- Search Icon -->
            <a
              href="#search"
              title="Search articles"
              class="text-slate-400 hover:text-white transition-colors p-1.5 rounded-full hover:bg-slate-800/70"
            >
              <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="11" cy="11" r="7"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
            </a>

            <!-- Telegram / Chat Icon -->
            <a
              href="https://t.me/channelmcg"
              target="_blank"
              rel="noopener noreferrer"
              title="Telegram Community"
              class="text-slate-400 hover:text-emerald-400 transition-colors p-1.5 rounded-full hover:bg-slate-800/70 hidden sm:inline-flex"
            >
              <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
              </svg>
            </a>

            <!-- Notification Bell Icon (with live status ping) -->
            <a
              href="/vip-trading-signals"
              title="Realtime MT5 Live Signals"
              class="relative text-slate-400 hover:text-white transition-colors p-1.5 rounded-full hover:bg-slate-800/70 hidden sm:inline-flex"
            >
              <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
              </svg>
              <span class="absolute top-1 right-1 w-2 h-2 bg-emerald-500 rounded-full animate-ping"></span>
              <span class="absolute top-1 right-1 w-2 h-2 bg-emerald-500 rounded-full"></span>
            </a>

            <!-- Dashboard Button (Substack style) -->
            <a
              href="/vip-trading-signals"
              class="text-xs font-semibold text-slate-100 bg-slate-800 hover:bg-emerald-600 hover:text-white border border-slate-700/80 px-3.5 py-1.5 rounded-full transition-all duration-200 shadow-sm"
            >
              Dashboard
            </a>
          </div>
        </div>

        <!-- Main Navigation Bar (Exact Substack Line Tabs) -->
        <nav class="flex items-center overflow-x-auto scrollbar-none text-xs sm:text-sm font-medium">
          <div class="flex items-center space-x-6 sm:space-x-8 whitespace-nowrap pt-1">
            {navItems.map((item) => {
              const isActive = activeNav === item.name;
              return (
                <a
                  href={item.href}
                  class={`relative pb-2.5 pt-1.5 transition-all font-medium ${
                    isActive
                      ? "text-white font-bold border-b-2 border-emerald-400 -mb-[1px]"
                      : item.isProduct
                      ? "text-amber-300 hover:text-amber-200 border-b-2 border-transparent hover:border-amber-400/50 -mb-[1px]"
                      : "text-slate-400 hover:text-slate-100 border-b-2 border-transparent hover:border-slate-500 -mb-[1px]"
                  }`}
                >
                  {item.isProduct && <span class="text-[11px] mr-1 text-amber-400">⚡</span>}
                  {item.name}
                </a>
              );
            })}
          </div>
        </nav>
      </div>
    </header>

    <!-- Main Content Slot -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-800 bg-[#080d14] text-slate-400 py-12 mt-16 text-xs sm:text-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
          <div class="space-y-3">
            <div class="text-white font-bold text-base">SMARTTRADER.VIP</div>
            <p class="text-slate-400 text-xs leading-relaxed">
              Global intelligence network: Institutional SMC market research, automated algorithmic trading, and scalable digital infrastructure for modern investors.
            </p>
          </div>
          <div>
            <h4 class="text-white font-semibold mb-3">Research & Intelligence</h4>
            <ul class="space-y-2 text-xs">
              <li><a href="/markets-ai-247" class="hover:text-emerald-400 transition-colors">Markets & AI 24/7</a></li>
              <li><a href="/ai-guides" class="hover:text-emerald-400 transition-colors">AI & Growth Guides</a></li>
              <li><a href="/crypto-gold-analysis" class="hover:text-emerald-400 transition-colors">Crypto & Gold SMC</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-white font-semibold mb-3">Solutions & Execution</h4>
            <ul class="space-y-2 text-xs">
              <li><a href="/mmo-infrastructure" class="hover:text-amber-400 transition-colors">MMO & Cloud Store</a></li>
              <li><a href="/vip-trading-signals" class="hover:text-amber-400 transition-colors">VIP Trading Signals</a></li>
              <li><a href="/automated-bot-trading" class="hover:text-amber-400 transition-colors">Automated Bot EA (MT5)</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-white font-semibold mb-3">Community & Support</h4>
            <p class="text-xs text-slate-400 mb-3">Join our global Telegram desk for real-time order flow and bot telemetry.</p>
            <div class="flex flex-col gap-2">
              <a href="https://t.me/channelmcg" target="_blank" class="text-emerald-400 hover:underline">✈️ Official Telegram Channel</a>
              <a href="https://t.me/willrich" target="_blank" class="text-emerald-400 hover:underline">💬 Founder Direct Support (@willrich)</a>
            </div>
          </div>
        </div>
        <div class="pt-8 border-t border-slate-800 text-center text-xs text-slate-400">
          <p>© 2026 SMARTTRADER.VIP - All Rights Reserved. Jamstack Edge Architecture on Cloudflare Pages & Notion CMS.</p>
        </div>
      </div>
    </footer>

  </body>
</html>
